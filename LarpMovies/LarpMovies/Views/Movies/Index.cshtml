@{
    ViewData["Title"] = "Movies";
}

<div class="card mb-4 border-primary">
    <div class="card-body">
        <label class="form-label fw-bold">Търсене с Gemini AI:</label>
        <div class="input-group">
            <input type="text" id="aiPromptInput" class="form-control" placeholder="Напр.: Екшъни с Киану Рийвс след 2010 г. с оценка над 7">
            <button class="btn btn-primary" id="aiSearchBtn" type="button">Търси</button>
        </div>
        <div id="aiInfoBox" class="mt-2 text-muted small d-none">
            <div id="aiExplanation" class="text-success fw-bold"></div>
            <div id="aiGeneratedSql" class="font-monospace"></div>
        </div>
    </div>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0 cq-title">Movies</h1>
    <div>
    <a asp-action="Create" class="btn btn-primary">+ New movie</a>
    <a asp-controller="Movies"
       asp-action="SurpriseMe"
       class="btn text-white fw-semibold"
       style="background-color: #8A9A5B; border-color: #8A9A5B; margin-right: 10px;">
        Surprise Me!
        </a>
    </div>
</div>

<div class="card shadow-sm" id="movies-app" data-list-url="@Url.Action("List")"
     data-edit-url="@Url.Action("Edit")"
     data-delete-url="@Url.Action("Delete")">
    <div class="card-body">
        <div class="input-group mb-3">
            <span class="input-group-text">&#128269;</span>
            <input type="search" id="movies-filter" class="form-control"
                   placeholder="Search by title, director, year, genre, actors..." autocomplete="off" />
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Title</th>
                        <th>Director</th>
                        <th>Year</th>
                        <th>Genre</th>
                        <th>Rating</th>
                        <th>Actors</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="movies-body">
                    <tr><td colspan="8" class="text-center text-muted py-4">Loading...</td></tr>
                </tbody>
            </table>
        </div>

        <div id="movies-info" class="text-muted small mt-3"></div>
    </div>
</div>

@section Scripts {
    <script src="~/js/movies.js" asp-append-version="true"></script>
}